<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews layout: only widget-safe views (LinearLayout, ImageView, TextView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/tarsmusic_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/tarsmusic_widget_bg"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:padding="12dp">

  <ImageView
    android:id="@+id/tarsmusic_widget_cover"
    android:layout_width="88dp"
    android:layout_height="88dp"
    android:background="@drawable/tarsmusic_widget_cover_bg"
    android:clipToOutline="true"
    android:contentDescription="@null"
    android:scaleType="centerCrop"
    android:src="@drawable/tarsmusic_widget_cover_placeholder" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/tarsmusic_widget_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:singleLine="true"
      android:text="@string/tarsmusic_widget_idle_title"
      android:textColor="#FFFFFFFF"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/tarsmusic_widget_artist"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:singleLine="true"
      android:text="@string/tarsmusic_widget_idle_subtitle"
      android:textColor="#B3FFFFFF"
      android:textSize="13sp" />

    <TextView
      android:id="@+id/tarsmusic_widget_lyric"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="2"
      android:textColor="#FF1D9BF0"
      android:textSize="13sp"
      android:textStyle="italic"
      android:visibility="gone" />

    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/tarsmusic_widget_previous"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/tarsmusic_widget_previous"
        android:padding="8dp"
        android:src="@drawable/tarsmusic_ic_previous" />

      <ImageView
        android:id="@+id/tarsmusic_widget_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/tarsmusic_widget_play_bg"
        android:contentDescription="@string/tarsmusic_widget_play"
        android:padding="10dp"
        android:src="@drawable/tarsmusic_ic_play" />

      <ImageView
        android:id="@+id/tarsmusic_widget_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/tarsmusic_widget_next"
        android:padding="8dp"
        android:src="@drawable/tarsmusic_ic_next" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
